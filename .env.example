# Every variable is optional. With none set, the full demo runs on deterministic fixtures.

# Claude (all agents). One key flips every agent to live; models are in src/llm/models.py.
ANTHROPIC_API_KEY=
# SHADOWBUYER_LLM=mock                 # force mock even with a key
# SHADOWBUYER_USE_FABLE=1              # Referee + Contract Exposer on claude-fable-5-1
# SHADOWBUYER_MODEL_FEE_HUNTER=...     # per-agent model override

# Stripe TEST MODE savings sweep. Live keys (sk_live_) are refused.
STRIPE_SECRET_KEY=

# Twilio SMS sandbox / trial number. Point the number's webhook at POST /sms/twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Memory is a local JSON file (owner profile, past statements, decisions, winning tactics).
# SHADOWBUYER_MEMORY_PATH=.shadowbuyer-memory.json
# SHADOWBUYER_APPROVAL_TIMEOUT_S=900
